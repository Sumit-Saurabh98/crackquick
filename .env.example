# MongoDB Atlas connection string: Atlas → Connect → Drivers. Replace every <...> part.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/crackquick

# Sign-in (Better Auth). Secret: any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The app's public URL (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Roles (user / editor / admin) are stored per account in the database. Make the first admin with
# `npm run set-role -- you@example.com admin`; after that, admins manage roles on the Users page.

# Optional social sign-in; each button shows up once both its values are set.
# GitHub: Settings → Developer settings → OAuth Apps. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
